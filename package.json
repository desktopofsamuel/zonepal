{
  "name": "zonepal",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "pnpm --filter @zonepal/web-app dev",
    "build": "pnpm --filter @zonepal/web-app build",
    "start": "pnpm --filter @zonepal/web-app start",
    "lint": "pnpm --filter @zonepal/web-app lint",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^9.0.4",
    "release-it": "^17.11.0"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@17/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Refactor"
            },
            {
              "type": "chore",
              "section": "Chore"
            }
          ]
        }
      }
    }
  }
}
